<Application
    x:Class="GamingHub.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="BgBrush" Color="#0A0E17" />
            <SolidColorBrush x:Key="PanelBrush" Color="#0F1626" />
            <SolidColorBrush x:Key="CardBrush" Color="#131D33" />
            <SolidColorBrush x:Key="AccentBrush" Color="#2D7DFF" />
            <SolidColorBrush x:Key="MutedBrush" Color="#8FA3BF" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#4CD08A" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
