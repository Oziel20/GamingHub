<Page
    x:Class="GamingHub.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GamingHub.Core.Models">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="14">
            <TextBlock Text="{x:Bind ViewModel.Welcome, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Stats, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Actualizar" Command="{x:Bind ViewModel.RefreshCommand}" />
                <Button Content="Marcar notificaciones como leídas" Command="{x:Bind ViewModel.MarkReadCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" Visibility="{x:Bind ViewModel.HasSuccess, Mode=OneWay}" />

            <TextBlock Text="Centro de notificaciones" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12">
                <ListView ItemsSource="{x:Bind ViewModel.Notifications}" SelectionMode="None" MaxHeight="220">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:NotificationDto">
                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <TextBlock Text="Historial de actividad" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12">
                <ListView ItemsSource="{x:Bind ViewModel.Activity}" SelectionMode="None" MaxHeight="360">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ActivityDto">
                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
