<Page
    x:Class="GamingHub.App.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Perfil" Style="{StaticResource TitleTextBlockStyle}" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="110" Height="110" CornerRadius="55" Background="#1B2B4A">
                    <Image Stretch="UniformToFill">
                        <Image.Source><BitmapImage UriSource="{x:Bind ViewModel.AvatarUri, Mode=OneWay}" /></Image.Source>
                    </Image>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="{x:Bind ViewModel.UserName, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.Stats, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    <Button Content="Cambiar avatar (PNG/JPG, máx. 2 MB)" Click="Avatar_Click" />
                </StackPanel>
            </Grid>
            <TextBox Header="Nombre para mostrar (2-32)" MaxLength="32" Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Header="Descripción (máx. 300)" MaxLength="300" AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                     Text="{x:Bind ViewModel.Bio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Guardar perfil" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource AccentButtonStyle}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left" />
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasSuccess, Mode=OneWay}" />
            <TextBlock Text="Juegos favoritos" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Favorites}" SelectionMode="None" />
        </StackPanel>
    </ScrollViewer>
</Page>
