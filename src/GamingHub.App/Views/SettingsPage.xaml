<Page
    x:Class="GamingHub.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GamingHub.Core.Models">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Configuración" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Seguridad de la cuenta" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Button Content="Cerrar sesión en todos los dispositivos" Command="{x:Bind ViewModel.LogoutEverywhereCommand}" />
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasSuccess, Mode=OneWay}" />

            <TextBlock Text="Directorios autorizados para juegos locales" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Roots}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="Quitar" Tag="{x:Bind}" Click="RemoveRoot_Click" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay}">
                <TextBlock Text="Administración local" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="Ruta de un directorio a autorizar" MaxLength="260" Text="{x:Bind ViewModel.NewRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Examinar…" Click="BrowseRoot_Click" />
                    <Button Grid.Column="2" Content="Autorizar" Command="{x:Bind ViewModel.AddRootCommand}" Style="{StaticResource AccentButtonStyle}" />
                </Grid>
                <TextBlock Text="Quitar directorio (solo admin): escribe la ruta exacta en el cuadro y usa Quitar" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                <Button Content="Quitar directorio indicado" Click="RemoveTyped_Click" />
                <TextBlock Text="Usuarios" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView ItemsSource="{x:Bind ViewModel.Users}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:UserAdminDto">
                            <StackPanel Spacing="4" Padding="0,6">
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Desbloquear" Tag="{x:Bind Id}" Click="Unlock_Click" />
                                    <Button Content="Revocar sesiones" Tag="{x:Bind Id}" Click="Revoke_Click" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
