<Page
    x:Class="GamingHub.App.Views.SocialPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GamingHub.Core.Models">
    <Grid Margin="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="10">
            <TextBlock Text="Amigos" Style="{StaticResource TitleTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Nombre de usuario" MaxLength="24" Text="{x:Bind ViewModel.NewFriendName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Content="Enviar solicitud" Command="{x:Bind ViewModel.AddFriendCommand}" Style="{StaticResource AccentButtonStyle}" />
            </Grid>
            <Button Content="Actualizar" Command="{x:Bind ViewModel.RefreshCommand}" />
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasSuccess, Mode=OneWay}" />
            <ListView ItemsSource="{x:Bind ViewModel.Friends}" SelectedItem="{x:Bind ViewModel.SelectedFriend, Mode=TwoWay}" MaxHeight="520">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:FriendDto">
                        <StackPanel Spacing="4" Padding="0,6">
                            <TextBlock Text="{x:Bind UserName}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind StatusText}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="Aceptar" Tag="{x:Bind FriendshipId}" Click="Accept_Click" Visibility="{x:Bind IsIncoming}" />
                                <Button Content="Rechazar" Tag="{x:Bind FriendshipId}" Click="Reject_Click" Visibility="{x:Bind IsIncoming}" />
                                <Button Content="Eliminar" Tag="{x:Bind FriendshipId}" Click="Remove_Click" />
                                <Button Content="Bloquear" Tag="{x:Bind UserId}" Click="Block_Click" Visibility="{x:Bind IsAccepted}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.ChatTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Grid.Row="1" Text="Chat LOCAL: los mensajes se guardan solo en este equipo; no hay servidor ni comunicación entre equipos. Se muestran como texto plano." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Messages}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MessageDto">
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{x:Bind Header}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox PlaceholderText="Escribe un mensaje (máx. 2000 caracteres)" MaxLength="2000" AcceptsReturn="False"
                             IsEnabled="{x:Bind ViewModel.CanChat, Mode=OneWay}"
                             Text="{x:Bind ViewModel.MessageText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Enviar" Command="{x:Bind ViewModel.SendCommand}" IsEnabled="{x:Bind ViewModel.CanChat, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
