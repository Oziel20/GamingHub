<Page
    x:Class="GamingHub.App.Views.StorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GamingHub.Core.Models">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="14">
            <TextBlock Text="Tienda" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="Modo local"
                     Message="No hay pasarela de pagos: las compras son simulaciones locales y los juegos del catálogo son títulos de demostración." />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Buscar en la tienda (2 a 100 caracteres)" MaxLength="100" KeyDown="Search_KeyDown"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1" Width="150" ItemsSource="{x:Bind ViewModel.Categories}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" />
                <Button Grid.Column="2" Content="Buscar" Command="{x:Bind ViewModel.SearchCommand}" Style="{StaticResource AccentButtonStyle}" />
                <Button Grid.Column="3" Content="Limpiar" Command="{x:Bind ViewModel.ClearSearchCommand}" />
            </Grid>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="24" Height="24" HorizontalAlignment="Left" />
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HasSuccess, Mode=OneWay}" />
            <TextBlock Text="No hay resultados." Foreground="{StaticResource MutedBrush}" Visibility="{x:Bind ViewModel.NoResults, Mode=OneWay}" />

            <GridView ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:CatalogItemDto">
                        <Border Width="270" Padding="14" CornerRadius="8" Background="{StaticResource CardBrush}">
                            <StackPanel Spacing="5">
                                <Grid Height="150" CornerRadius="6" Background="#1B2B4A">
                                    <TextBlock Text="{x:Bind Initial}" FontSize="40" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <BitmapImage UriSource="{x:Bind ImageUri}" />
                                        </Image.Source>
                                    </Image>
                                </Grid>
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Category}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{x:Bind Description}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind SizeText}" FontSize="12" />
                                <TextBlock Text="{x:Bind PriceText}" FontSize="16" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{x:Bind StatusText}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                <Button Content="Agregar al carrito" Tag="{x:Bind Id}" Click="AddCart_Click" IsEnabled="{x:Bind CanAdd}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="◀ Anterior" Command="{x:Bind ViewModel.PrevPageCommand}" IsEnabled="{x:Bind ViewModel.CanPrev, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.PageText, Mode=OneWay}" VerticalAlignment="Center" />
                <Button Content="Siguiente ▶" Command="{x:Bind ViewModel.NextPageCommand}" IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}" />
            </StackPanel>

            <TextBlock Text="Carrito" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12">
                <StackPanel Spacing="8">
                    <ListView ItemsSource="{x:Bind ViewModel.Cart}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CatalogItemDto">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind PriceText}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="Quitar" Tag="{x:Bind Id}" Click="RemoveCart_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Bind ViewModel.CartTotalText, Mode=OneWay}" />

                    <!-- AQUÍ ESTÁ EL CAMBIO: Command se cambió por Click="PagarButton_Click" -->
                    <Button Content="Comprar (simulado)" Click="PagarButton_Click" IsEnabled="{x:Bind ViewModel.HasCart, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" />

                </StackPanel>
            </Border>

            <TextBlock Text="Historial de compras (simuladas)" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Border Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12">
                <ListView ItemsSource="{x:Bind ViewModel.Purchases}" SelectionMode="None" MaxHeight="260">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PurchaseDto">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Ver ticket" Tag="{x:Bind OrderId}" IsEnabled="{x:Bind HasTicket}" Click="ViewTicket_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>