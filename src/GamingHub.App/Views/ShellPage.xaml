<Page
    x:Class="GamingHub.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <NavigationView x:Name="Nav" PaneDisplayMode="Auto" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                    OpenPaneLength="230" Background="{StaticResource BgBrush}" ItemInvoked="Nav_ItemInvoked">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Inicio" Tag="dashboard" Icon="Home" />
            <NavigationViewItem Content="Biblioteca" Tag="library" Icon="Library" />
            <NavigationViewItem Content="Tienda" Tag="store" Icon="Shop" />
            <NavigationViewItem Content="Amigos y chat" Tag="social" Icon="People" />
            <NavigationViewItem Content="Perfil" Tag="profile" Icon="Contact" />
            <NavigationViewItem Content="Configuración" Tag="settings" Icon="Setting" />
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <StackPanel Margin="12" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.UserText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                <Button Content="Cerrar sesión" Command="{x:Bind ViewModel.LogoutCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </NavigationView.PaneFooter>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
